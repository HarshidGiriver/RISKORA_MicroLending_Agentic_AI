# Reference configuration. This file is NOT loaded automatically.
# Export variables in your shell BEFORE starting run.py.
# Relative file paths resolve from the repository root.

# Local-only binding. Remote deployment needs separate HTTPS/access controls.
RISKORA_HOST=127.0.0.1
# Positional port in `python run.py 8010` overrides this value.
RISKORA_PORT=8000

# Private mutable database. Do not point this at the tracked historical demo DB.
# Tests override their database path with a temporary file automatically.
RISKORA_DB_PATH=data/runtime/riskora.db

# Committed synthetic dataset; no external borrower data is needed to start.
RISKORA_DATA_PATH=data/loan_default_full.csv
# Keep riskora_model.joblib, preprocessor.joblib and model_metrics.json together.
RISKORA_ARTIFACTS_DIR=ml/artifacts

# Login accounts are created through first-use setup, not environment passwords.
