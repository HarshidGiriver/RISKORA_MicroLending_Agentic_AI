# Python-generated files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environments
.venv/
venv/

# Local secrets (keep example configuration trackable)
.env
.env.*
!.env.example

# Temporary SQLite sidecars; keep the existing application database
*.db-journal
*.db-wal
*.db-shm

# Operating-system clutter
.DS_Store
Thumbs.db

# Private local runtime data and working files
data/runtime/
tmp/

# Private databases and backups outside the default runtime directory.
# Existing tracked historical data/riskora.db remains tracked.
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.bak
*.log
# Incoming archives and local request/session exports are not source code.
*.zip
cookies*.txt
